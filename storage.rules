rules_version = '2';

// Storage de Sapere.
// Las URLs de descarga con token (getDownloadURL en la app y las que genera
// functions/src/storage.js) funcionan SIN pasar por estas reglas: los ficheros
// siguen siendo compartibles por URL sin abrir el bucket entero. Lo que estas
// reglas controlan es el acceso por SDK (leer y LISTAR por ruta), que antes era
// publico y exponia las carpetas con el email de cada usuario.
// Lectura publica solo donde se ensena a todos: portadas del servidor, assets
// de la app y fotos de perfil.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(owner) {
      return signedIn() && request.auth.uid == owner;
    }

    // Carpetas antiguas creadas con el email como segmento de ruta.
    function isMyEmail(owner) {
      return signedIn() && request.auth.token.email == owner;
    }

    // Solo los tipos que sube la app y con tope de tamano. Ya no existe el
    // escape `request.resource == null`, que aprobaba cualquier borrado.
    function isAllowedUpload(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType != null
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*')
            || request.resource.contentType == 'application/pdf');
    }

    match /audios/{owner}/{allPaths=**} {
      allow read, delete: if isMe(owner) || isMyEmail(owner);
      allow create, update: if isMe(owner) && isAllowedUpload(100 * 1024 * 1024);
    }

    match /profile/{owner}/{allPaths=**} {
      allow read, delete: if isMe(owner) || isMyEmail(owner);
      allow create, update: if isMe(owner) && isAllowedUpload(10 * 1024 * 1024);
    }

    match /gamification_covers/{owner}/{allPaths=**} {
      allow read, delete: if isMe(owner) || isMyEmail(owner);
      allow create, update: if isMe(owner) && isAllowedUpload(10 * 1024 * 1024);
    }

    match /public/{owner}/{allPaths=**} {
      allow read, delete: if isMe(owner) || isMyEmail(owner);
      allow create, update: if isMe(owner) && isAllowedUpload(10 * 1024 * 1024);
    }

    match /profileImages/{file} {
      allow read: if true;
      allow create, update: if signedIn()
        && file == request.auth.uid + '.jpg'
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if signedIn() && file == request.auth.uid + '.jpg';
    }

    match /app_assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Portadas generadas por Cloud Functions (covers/<docId>.png).
    // Escritura solo desde el servidor (el Admin SDK se salta estas reglas).
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Carpeta por uid que la app vacia al borrar la cuenta (listAll + delete).
    match /{owner}/{allPaths=**} {
      allow read, delete: if isMe(owner);
      allow create, update: if false;
    }
  }
}
