rules_version = '2';

// Reglas de Sapere. Antes: allow read, write para todo (abierto a cualquiera).
// Las Cloud Functions usan el Admin SDK y no pasan por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsByField(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }

    function createsAsSelf(field) {
      return signedIn() && request.resource.data[field] == request.auth.uid;
    }

    // Perfil del usuario. El saldo de créditos solo lo cambia el backend.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (!('credits' in request.resource.data) || request.resource.data.credits == 0);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits']);
      allow delete: if isOwner(uid);
    }

    // Audiodocumentales: catálogo visible para usuarios autenticados.
    // Los crea y los hace avanzar SOLO el servidor (startStory, generateStory,
    // sweepStalled). La tarea y el barrido deciden cobros y reembolsos mirando
    // status y generation, así que el cliente no puede tocar esos campos, ni el
    // texto, ni la portada (la valida startStory), ni el dueño: solo renombrar y
    // borrar los suyos.
    match /sapere/{postId} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if ownsByField('uId')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bukbukName'])
        && request.resource.data.bukbukName is string
        && request.resource.data.bukbukName.size() <= 120;
      allow delete: if ownsByField('uId');
    }

    // Comentar un post ajeno: solo AÑADIR un comentario al final, firmado con el
    // propio uid, sin tocar los anteriores (antes se podía vaciar la lista o
    // firmar con el uid de otro).
    function appendsOwnComment() {
      let before = resource.data.get('comments', null) == null ? [] : resource.data.comments;
      let after = request.resource.data.get('comments', null) == null ? [] : request.resource.data.comments;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && after.size() == before.size() + 1
        && after[0:before.size()] == before
        && after[before.size()].uid == request.auth.uid;
    }

    // Comunidad: leer autenticado; crear como uno mismo; el creador edita y
    // borra su post; los demás solo añaden su comentario.
    match /community/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creator.uid == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.creator.uid == request.auth.uid || appendsOwnComment());
      allow delete: if signedIn() && resource.data.creator.uid == request.auth.uid;
    }

    // Configuración del catálogo: lectura autenticada. La app crea categorías
    // nuevas al generar un documental; nadie las edita ni borra desde el cliente.
    match /sapereCategories/{categoryId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
      match /sapereTypes/{typeId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /covers_categories/{categoryId} {
      allow read: if signedIn();
      allow write: if false;
      match /covers/{coverId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Claves de servicio: cerradas del todo. Las claves viven en Secret Manager
    // (Cloud Functions); cualquier usuario registrado podía leerlas desde aquí.
    match /keys/{keyId} {
      allow read, write: if false;
    }

    match /gamification_profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /learning_profiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /learning_notes/{noteId} {
      allow read, update, delete: if ownsByField('userId');
      allow create: if createsAsSelf('userId');
    }

    match /learning_cards/{cardId} {
      allow read, update, delete: if ownsByField('userId');
      allow create: if createsAsSelf('userId');
    }

    // Colecciones antiguas que solo se tocan al borrar la cuenta.
    match /Users/{docId} {
      allow read, delete: if ownsByField('uId');
      allow create, update: if false;
    }

    match /Posts/{docId} {
      allow read, delete: if ownsByField('uId');
      allow create, update: if false;
    }

    // Registro de gastos de créditos y cerrojos de generación: solo el backend.
    match /creditSpends/{spendId} {
      allow read, write: if false;
    }

    match /generationLocks/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
